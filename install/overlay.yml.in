# Adds the multimodal and memory packages to a DSH profile (passed with --patch).
# setup.sh / setup.ps1 substitute @DSH@ (the harness), @DATA@ (memory, models, browser profile)
# and @BROWSER@ (the co-canvas browser choice).
- insert:
    - id: tool-read-document
      name: '@DSH@/packages/multimodal/tool-read-document/src/index.ts'
    - id: vision-bridge
      name: '@DSH@/packages/multimodal/vision-bridge/src/index.ts'
    - id: speech-to-text
      name: '@DSH@/packages/experimental/speech-to-text/src/index.ts'
      config:
        defaultProvider: sensevoice-local
    - id: speech-to-text-sensevoice
      name: '@DSH@/packages/experimental/speech-to-text-sensevoice/src/index.ts'
      config:
        dataRoot: '@DATA@/sensevoice'
    - id: tool-read-audio
      name: '@DSH@/packages/experimental/tool-read-audio/src/index.ts'
    - id: tool-read-video
      name: '@DSH@/packages/experimental/tool-read-video/src/index.ts'
    - id: memory
      name: '@DSH@/packages/memory/memory/src/index.ts'
      config:
        root: '@DATA@/memory'
    - id: co-canvas
      name: '@DSH@/packages/experimental/co-canvas/src/index.ts'
      config:
        userDataDir: '@DATA@/co-canvas-profile'
@BROWSER@
    - id: ui-co-canvas
      name: '@DSH@/packages/experimental/client-ui-co-canvas/src/index.ts'
    - id: browser-use
      name: '@DSH@/packages/browser-use/browser-use/src/index.ts'
    - id: browser-use-playwright-mcp
      name: '@DSH@/packages/experimental/browser-use-playwright-mcp/src/index.ts'
      config:
        mode: attach
        endpoint: 'http://127.0.0.1:9333'
