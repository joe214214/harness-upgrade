# Adds the multimodal, memory, agent-bridge, co-canvas and computer-use packages to a DSH profile (passed with --patch).
# setup.sh / setup.ps1 fill in the placeholders for the harness path, the data folder (memory, models,
# browser profile) and the co-canvas browser choice; the browser placeholder occupies a line of its own.
- insert:
    - id: tool-read-document
      name: '@DSH@/packages/multimodal/tool-read-document/src/index.ts'
    - id: vision-bridge
      name: '@DSH@/packages/multimodal/vision-bridge/src/index.ts'
    - id: speech-to-text
      name: '@DSH@/packages/experimental/speech-to-text/src/index.ts'
      config:
        defaultProvider: sensevoice-local
    - id: speech-to-text-sensevoice
      name: '@DSH@/packages/experimental/speech-to-text-sensevoice/src/index.ts'
      config:
        dataRoot: '@DATA@/sensevoice'
    - id: tool-read-audio
      name: '@DSH@/packages/experimental/tool-read-audio/src/index.ts'
    - id: tool-read-video
      name: '@DSH@/packages/experimental/tool-read-video/src/index.ts'
    - id: memory
      name: '@DSH@/packages/memory/memory/src/index.ts'
      config:
        root: '@DATA@/memory'
    - id: agent-bridge
      name: '@DSH@/packages/experimental/agent-bridge/src/index.ts'
      config:
        stateDir: '@DATA@/agent-bridge'
        memoryFile: '@DATA@/memory/MEMORY.md'
    - id: ui-agent-bridge
      name: '@DSH@/packages/experimental/client-ui-agent-bridge/src/index.ts'
    - id: co-canvas
      name: '@DSH@/packages/experimental/co-canvas/src/index.ts'
      config:
        userDataDir: '@DATA@/co-canvas-profile'
        dataDir: '@DATA@/co-canvas'
        desktop: true
        # Computer-use tools that duplicate the shared browser's or that the agent does not need; about 11K fewer tokens per request.
        hiddenTools: '^cua_driver_native__(browser_\w+|get_browser_state|start_recording|stop_recording|get_recording_state|replay_trajectory|install_ffmpeg|set_agent_cursor_\w+|get_agent_cursor_state|health_report|get_config|set_config|start_session|escalate_session|get_session|list_sessions|get_session_state|end_session|mouse_button_down|mouse_button_up|mouse_drag|parallel_mouse_drag|page)$'
@BROWSER@
    - id: ui-co-canvas
      name: '@DSH@/packages/experimental/client-ui-co-canvas/src/index.ts'
    - id: browser-use
      name: '@DSH@/packages/browser-use/browser-use/src/index.ts'
    - id: browser-use-playwright-mcp
      name: '@DSH@/packages/experimental/browser-use-playwright-mcp/src/index.ts'
      config:
        mode: attach
        endpoint: 'http://127.0.0.1:9333'
    - id: computer-use
      name: '@DSH@/packages/computer-use/computer-use/src/index.ts'
    - id: computer-use-cua-driver-native
      name: '@DSH@/packages/experimental/computer-use-cua-driver-native/src/index.ts'
