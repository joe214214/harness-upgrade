# RTX 5070 (Blackwell sm_120) 需要 CUDA 12.8+。
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv espeak-ng && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/gateway:/app/worker
RUN python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
COPY requirements.txt requirements-gpu.txt ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128 \
 && pip install --no-cache-dir -r requirements-gpu.txt
COPY gateway/ ./gateway/
COPY worker/ ./worker/
CMD ["python", "-m", "relay_worker.main"]
