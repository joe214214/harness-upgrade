RELAY_ENV=dev
RELAY_DATABASE_URL=sqlite+aiosqlite:///./relay.db
RELAY_REDIS_URL=redis://localhost:6379/0
RELAY_USE_FAKE_REDIS=false
RELAY_BACKEND=mock            # mock | local | vllm
# balanced  VLM+Whisper+TTS，7.3GB —— 需要整张卡（桌面占用 <0.7GB）
# compact   只有 VLM，4.5GB —— 笔记本/桌面占显存时用这个
# voice     小 LLM+Whisper+TTS，5.5GB —— 语音闭环，放弃视觉
# llm-only  7B-AWQ，7.3GB  |  asr-only  只有语音，4.3GB
RELAY_MODEL_PROFILE=balanced

# 桌面本身要占的显存。台式独占卡 0.8 够；笔记本屏幕直连独显时桌面吃 1.5-2GB。
# 先跑 nvidia-smi 看 Memory-Usage，按那个数字 +0.4 设置。
# RELAY_VRAM_HEADROOM_GB=0.8
RELAY_ADMIN_TOKEN=dev-admin-token
RELAY_MAX_QUEUE_DEPTH=256
RELAY_BATCH_WINDOW_MS=20
RELAY_MAX_BATCH_SIZE=8

# 对外暴露时改成公网地址（web 构建期内联进前端）
# RELAY_PUBLIC_API_URL=https://api.example.com
RELAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
