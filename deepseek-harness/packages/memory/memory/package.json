{
  "name": "@deepseek-ai/dsh-memory",
  "description": "Cross-Session long-term memory: a size-capped MEMORY.md the agent curates, FTS5 episodic recall over past Sessions, and a post-turn reflect pass, built on system-prompt context, tools, and agent/turn-stopping",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
